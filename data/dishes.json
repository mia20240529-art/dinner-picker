[
  {
    "id": "steamed_bass",
    "name": "清蒸鲈鱼",
    "category": "fish",
    "category_label": "鱼类",
    "role": "main",
    "roles": [
      "main"
    ],
    "servings": 2,
    "time": 25,
    "difficulty": "简单",
    "light": true,
    "oily": false,
    "starchy": false,
    "ingredients": [
      "鲈鱼1条约500g（已处理干净）",
      "姜15g",
      "葱2根"
    ],
    "seasonings": [
      "蒸鱼豉油2茶匙",
      "食用油1茶匙"
    ],
    "steps": [
      "鱼清理干净擦干，两面各划两刀，鱼腹放姜片。",
      "蒸锅加水烧开，鱼放在铺有姜葱的盘中。",
      "大火蒸10—12分钟，关火焖2分钟；鱼肉应完全不透明并能轻松剥离鱼骨，较厚的鱼延长时间。",
      "倒掉盘中蒸汁，去掉旧姜葱，铺新葱丝。",
      "淋蒸鱼豉油，另烧热1茶匙油淋在葱丝上。"
    ],
    "tags": [
      "鱼",
      "蒸"
    ],
    "avoid_pair_tags": [],
    "substitutions": [
      "鲈鱼可换鳜鱼，按鱼的厚度调整蒸制时间。"
    ],
    "note": "购买时请处理干净；食用时留意鱼刺。",
    "brothy": false
  },
  {
